[sub_resource type="Shader" id="WorkshopBeamShader"]
code = "shader_type canvas_item;
render_mode unshaded;
void fragment() {
    float width = mix(0.025, 0.5, UV.y);
    float edge = 1.0 - smoothstep(width * 0.55, width, abs(UV.x - 0.5));
    float fade = smoothstep(0.0, 0.08, UV.y) * (1.0 - smoothstep(0.65, 1.0, UV.y));
    COLOR = vec4(0.55, 0.67, 0.72, edge * fade * 0.025);
}
"

