[sub_resource type="Shader" id="BayBackdropShader"]
code = "shader_type canvas_item;
render_mode unshaded;
void fragment() {
    vec2 p = floor(UV * vec2(640.0, 360.0));
    vec2 wall_uv = (p - vec2(320.0, 145.0)) / vec2(290.0, 220.0);
    float wall_light = max(0.0, 1.0 - dot(wall_uv, wall_uv));
    vec3 color = vec3(0.095, 0.125, 0.145) + wall_light * vec3(0.045, 0.05, 0.055);
    float side = smoothstep(70.0, 145.0, min(p.x, 639.0 - p.x));
    color *= mix(0.3, 1.0, side);
    if (p.y < 254.0) {
        // Recessed joints with restrained bevels, rather than black panel outlines.
        if (p.x == 207.0 || p.x == 431.0 || p.y == 83.0) color *= 0.80;
        if (p.x == 206.0 || p.x == 430.0 || p.y == 82.0) color *= 1.10;
        if (p.x == 208.0 || p.x == 432.0 || p.y == 84.0) color *= 0.95;
        color *= mix(0.65, 1.0, smoothstep(0.0, 45.0, p.y));
    } else if (p.y < 262.0) {
        // A shallow metal skirting joins the wall and floor.
        color *= 0.74;
        if (p.y == 254.0) color *= 1.28;
        if (p.y == 255.0) color *= 1.08;
        if (p.y >= 260.0) color *= 0.72;
    } else {
        color = vec3(0.067, 0.079, 0.085) * mix(0.5, 1.0, side);
        vec2 floor_uv = (p - vec2(320.0, 280.0)) / vec2(170.0, 34.0);
        float pool = max(0.0, 1.0 - dot(floor_uv, floor_uv));
        color += pool * pool * vec3(0.05, 0.06, 0.065);
        // Broad, faint wear on continuous concrete; no tile grid or fine noise.
        vec2 wear_a = (p - vec2(245.0, 296.0)) / vec2(76.0, 11.0);
        wear_a.y += wear_a.x * 0.28;
        vec2 wear_b = (p - vec2(391.0, 320.0)) / vec2(93.0, 14.0);
        wear_b.y -= wear_b.x * 0.21;
        vec2 wear_c = (p - vec2(344.0, 278.0)) / vec2(48.0, 7.0);
        float wear = (1.0 - smoothstep(0.1, 1.0, dot(wear_a, wear_a))) * 0.035;
        wear -= (1.0 - smoothstep(0.15, 1.0, dot(wear_b, wear_b))) * 0.04;
        wear += (1.0 - smoothstep(0.2, 1.0, dot(wear_c, wear_c))) * 0.025;
        color *= 1.0 + wear;
        color *= mix(0.70, 1.0, smoothstep(262.0, 273.0, p.y));
        color *= mix(1.0, 0.6, smoothstep(280.0, 360.0, p.y));
    }
    float side_fade = 1.0 - smoothstep(95.0, 260.0, abs(p.x - 320.0));
    float bottom_fade = 1.0 - smoothstep(250.0, 345.0, p.y);
    vec2 lower_curve = vec2((p.x - 320.0) / 260.0, max(0.0, p.y - 185.0) / 160.0);
    float rounded_fade = 1.0 - smoothstep(0.65, 1.0, length(lower_curve));
    color *= side_fade * bottom_fade * rounded_fade;
    COLOR = vec4(color, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="BayBackdropMaterial"]
shader = SubResource("BayBackdropShader")

